generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  no_telepon   String?
  password     String
  avatar       String?
  bio          String?
  location     String?
  role         String   @default("STUDENT") // STUDENT, UMKM, ADMIN
  portfolioUrl String?
  github       String?
  linkedin     String?
  behance      String?
  saldo        Int      @default(0) @db.Integer
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updateAt     DateTime @updatedAt @db.Timestamp(6)

  student                  student?
  umkm                     umkm?
  admin                    admin?
  sentMessages             message[]                   @relation("MessageSender")
  receivedMessages         message[]                   @relation("MessageRecipient")
  notifications            notification[]
  notificationPreference   notification_preference?
  sessions                 auth_session[]
  releasedPayments         project_payment[]           @relation("PaymentReleasedTo")
  balanceTransactions      balance_transaction[]
  messageAttachmentUploads message_attachment_upload[]

  @@index([createdAt, id])
}

model auth_session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  userAgent  String?  @db.VarChar(512)
  ipAddress  String?  @db.VarChar(64)
  expiresAt  DateTime @db.Timestamp(6)
  lastSeenAt DateTime @default(now()) @db.Timestamp(6)
  createdAt  DateTime @default(now()) @db.Timestamp(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model security_rate_limit {
  key       String   @id @db.VarChar(96)
  count     Int
  resetAt   DateTime @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([resetAt])
}

model student {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  school             String?
  tingkat_pendidikan String?
  jurusan            String?
  semester           Int?
  alamat_detail      String?
  provinsi_kode      String?
  provinsi_nama      String?
  kabupaten_kode     String?
  kabupaten_nama     String?
  kecamatan_kode     String?
  kecamatan_nama     String?
  kelurahan_kode     String?
  kelurahan_nama     String?
  experience         Int      @default(0) // years or months
  available          Boolean  @default(false)
  rating             Float    @default(0)
  total_project      Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  updateAt           DateTime @updatedAt @db.Timestamp(6)

  user        user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      student_skill[]
  portfolios  portfolio[]
  proposals   proposal[]
  projects    project[]            @relation("ProjectStudent")
  reviews     review[]
  submissions project_submission[]

  @@index([available, rating, total_project, createdAt])
  @@index([createdAt, id])
}

model umkm {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  nama_usaha     String
  kategori_usaha String?
  website        String?
  alamat_detail  String?
  provinsi_kode  String?
  provinsi_nama  String?
  kabupaten_kode String?
  kabupaten_nama String?
  kecamatan_kode String?
  kecamatan_nama String?
  kelurahan_kode String?
  kelurahan_nama String?
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updateAt       DateTime @updatedAt @db.Timestamp(6)

  user     user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects project[]
  reviews  review[]

  @@index([createdAt, id])
}

model business_category {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  groupName  String?
  groupOrder Int      @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)

  @@index([isActive, groupOrder, sortOrder, name])
  @@index([isActive, groupName])
}

model admin {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updateAt  DateTime @updatedAt @db.Timestamp(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   @default("INFO")
  title     String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model notification_preference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  proposalMasuk Boolean  @default(true)
  pesanBaru     Boolean  @default(true)
  pembayaran    Boolean  @default(true)
  updateProyek  Boolean  @default(true)
  promosiInfo   Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model skill {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  category  String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  studentSkills student_skill[]
  projectSkills project_skill[]
}

model student_skill {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @db.Uuid
  skillId    String   @db.Uuid
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)

  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
  @@index([skillId, studentId])
}

model project_skill {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  skillId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@index([skillId, projectId])
}

model portfolio {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  link        String?
  image       String?
  studentId   String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, updatedAt])
}

model project {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String
  budget      Float?
  deadline    DateTime?
  workMode    String    @default("REMOTE") // REMOTE, HYBRID, ONSITE
  location    String?
  status      String    @default("OPEN") // OPEN, PROPOSAL, IN_PROGRESS, REVIEW, COMPLETED, CANCELLED
  umkmId      String    @db.Uuid
  studentId   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)

  umkm              umkm                        @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  student           student?                    @relation("ProjectStudent", fields: [studentId], references: [id], onDelete: SetNull)
  skillsNeeded      project_skill[]
  proposals         proposal[]
  review            review?
  messages          message[]
  payment           project_payment?
  submission        project_submission?
  attachmentUploads message_attachment_upload[]

  @@index([umkmId, status, createdAt])
  @@index([umkmId, status, updatedAt])
  @@index([status, studentId, createdAt])
  @@index([studentId, status, updatedAt])
  @@index([status, deadline])
}

model message {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  senderId    String    @db.Uuid
  recipientId String    @db.Uuid
  content     String    @db.VarChar(2000)
  readAt      DateTime? @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)

  project    project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender     user                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient  user                @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  attachment message_attachment?

  @@index([projectId, createdAt])
  @@index([recipientId, readAt])
  @@index([senderId, createdAt])
}

model message_attachment {
  id          String   @id @default(uuid()) @db.Uuid
  messageId   String   @unique @db.Uuid
  storagePath String   @unique @db.VarChar(1024)
  fileName    String   @db.VarChar(255)
  contentType String   @db.VarChar(255)
  sizeBytes   BigInt
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  message message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model message_attachment_upload {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  uploaderId  String   @db.Uuid
  storagePath String   @unique @db.VarChar(1024)
  fileName    String   @db.VarChar(255)
  contentType String   @db.VarChar(255)
  sizeBytes   BigInt
  expiresAt   DateTime @db.Timestamp(6)
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  project  project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader user    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId, expiresAt])
  @@index([projectId, createdAt])
  @@index([expiresAt])
}

model proposal {
  id          String   @id @default(uuid()) @db.Uuid
  coverLetter String?
  budgetMatch Boolean?
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  projectId   String   @db.Uuid
  studentId   String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([projectId, studentId])
  @@index([projectId, createdAt])
  @@index([studentId, status, createdAt])
}

model review {
  id        String   @id @default(uuid()) @db.Uuid
  rating    Float
  comment   String?
  projectId String   @unique @db.Uuid
  studentId String   @db.Uuid
  umkmId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  umkm    umkm    @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model project_payment {
  id                    String    @id @default(uuid()) @db.Uuid
  projectId             String    @unique @db.Uuid
  orderId               String    @unique @db.VarChar(50)
  amount                Int       @db.Integer
  status                String    @default("CREATING") // CREATING, PENDING, HELD, RELEASED, FAILED, EXPIRED, CANCELLED, REFUNDED, CHARGEBACK
  snapToken             String?
  redirectUrl           String?
  midtransTransactionId String?
  paymentType           String?
  fraudStatus           String?
  rawStatus             Json?
  reversedAmount        Int       @default(0) @db.Integer
  paidAt                DateTime? @db.Timestamp(6)
  heldAt                DateTime? @db.Timestamp(6)
  releasedAt            DateTime? @db.Timestamp(6)
  releasedToUserId      String?   @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @db.Timestamp(6)

  project             project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releasedTo          user?                 @relation("PaymentReleasedTo", fields: [releasedToUserId], references: [id], onDelete: SetNull)
  balanceTransactions balance_transaction[]

  @@index([status, createdAt])
  @@index([releasedToUserId, releasedAt])
}

model balance_transaction {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  projectPaymentId  String   @db.Uuid
  externalReference String?  @unique @db.VarChar(160)
  type              String   @default("PROJECT_EARNING")
  amount            Int      @db.Integer
  balanceBefore     Int      @db.Integer
  balanceAfter      Int      @db.Integer
  createdAt         DateTime @default(now()) @db.Timestamp(6)

  user           user            @relation(fields: [userId], references: [id], onDelete: Restrict)
  projectPayment project_payment @relation(fields: [projectPaymentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([projectPaymentId, createdAt])
}

model project_submission {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @unique @db.Uuid
  studentId   String    @db.Uuid
  resultUrl   String?
  notes       String    @db.VarChar(3000)
  status      String    @default("SUBMITTED") // SUBMITTED, APPROVED
  submittedAt DateTime  @default(now()) @db.Timestamp(6)
  approvedAt  DateTime? @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, submittedAt])
}
