generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model user {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  name       String?
  no_telepon String?
  password   String
  role       String   @default("STUDENT")
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updateAt   DateTime @updatedAt @db.Timestamp(6)
}
