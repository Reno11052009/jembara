generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  name       String?
  no_telepon String?
  password   String
  avatar     String?
  bio        String?
  location   String?
  role         String   @default("STUDENT") // STUDENT, UMKM, ADMIN
  portfolioUrl String?
  github       String?
  linkedin     String?
  behance      String?
  saldo        Int      @default(0) @db.Integer
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updateAt   DateTime @updatedAt @db.Timestamp(6)

  student student?
  umkm    umkm?
  admin   admin?
  sentMessages message[] @relation("MessageSender")
  receivedMessages message[] @relation("MessageRecipient")
  notifications notification[]
  notificationPreference notification_preference?
  sessions auth_session[]
}

model auth_session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  userAgent  String?  @db.VarChar(512)
  ipAddress  String?  @db.VarChar(64)
  expiresAt  DateTime @db.Timestamp(6)
  lastSeenAt DateTime @default(now()) @db.Timestamp(6)
  createdAt  DateTime @default(now()) @db.Timestamp(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

model security_rate_limit {
  key       String   @id @db.VarChar(96)
  count     Int
  resetAt   DateTime @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([resetAt])
}

model student {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  school             String?
  tingkat_pendidikan String?
  jurusan            String?
  semester           Int?
  experience         Int      @default(0) // years or months
  available          Boolean  @default(false)
  rating             Float    @default(0)
  total_project      Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  updateAt           DateTime @updatedAt @db.Timestamp(6)

  user       user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills     student_skill[]
  portfolios portfolio[]
  proposals  proposal[]
  projects   project[]       @relation("ProjectStudent")
  reviews    review[]
}

model umkm {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  nama_usaha     String
  kategori_usaha String?
  website        String?
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updateAt       DateTime @updatedAt @db.Timestamp(6)

  user     user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects project[]
  reviews  review[]
}

model admin {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updateAt  DateTime @updatedAt @db.Timestamp(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   @default("INFO")
  title     String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model notification_preference {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  proposalMasuk  Boolean  @default(true)
  pesanBaru      Boolean  @default(true)
  pembayaran     Boolean  @default(true)
  updateProyek   Boolean  @default(true)
  promosiInfo    Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model skill {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  category  String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  studentSkills student_skill[]
  projectSkills project_skill[]
}

model student_skill {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @db.Uuid
  skillId    String   @db.Uuid
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @db.Timestamp(6)

  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
}

model project_skill {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  skillId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
}

model portfolio {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  link        String?
  image       String?
  studentId   String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model project {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String
  budget      Float?
  deadline    DateTime?
  workMode    String    @default("REMOTE") // REMOTE, HYBRID, ONSITE
  location    String?
  status      String    @default("OPEN") // OPEN, PROPOSAL, IN_PROGRESS, REVIEW, COMPLETED, CANCELLED
  umkmId      String    @db.Uuid
  studentId   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)

  umkm         umkm            @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  student      student?        @relation("ProjectStudent", fields: [studentId], references: [id], onDelete: SetNull)
  skillsNeeded project_skill[]
  proposals    proposal[]
  review       review?
  messages     message[]

  @@index([umkmId, status, createdAt])
}

model message {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  senderId    String    @db.Uuid
  recipientId String    @db.Uuid
  content     String    @db.VarChar(2000)
  readAt      DateTime? @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @db.Timestamp(6)

  project   project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    user    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient user    @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([recipientId, readAt])
  @@index([senderId, createdAt])
}

model proposal {
  id          String   @id @default(uuid()) @db.Uuid
  coverLetter String?
  budgetMatch Boolean?
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  projectId   String   @db.Uuid
  studentId   String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([projectId, studentId])
}

model review {
  id        String   @id @default(uuid()) @db.Uuid
  rating    Float
  comment   String?
  projectId String   @unique @db.Uuid
  studentId String   @db.Uuid
  umkmId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  umkm    umkm    @relation(fields: [umkmId], references: [id], onDelete: Cascade)
}
