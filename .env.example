DATABASE_URL=
DIRECT_URL=
# Opsional tetapi direkomendasikan: CA Supabase dalam format PEM yang di-base64
# untuk verifikasi sertifikat penuh. Tanpa nilai ini koneksi tetap diwajibkan TLS.
DATABASE_SSL_CA_BASE64=
SESSION_SECRET=

# Wajib saat menjalankan `npm run db:seed`; jangan gunakan nilai contoh/default.
ADMIN_SEED_NAME="Admin Jembara"
ADMIN_SEED_EMAIL="admin@jembara.web.id"
ADMIN_SEED_PASSWORD=

# Wajib saat menjalankan `npm run db:provision-runtime`.
DATABASE_RUNTIME_ROLE="jembara_runtime"
DATABASE_RUNTIME_PASSWORD=
# Set true hanya saat sengaja merotasi password role yang sudah ada.
DATABASE_RUNTIME_ROTATE_PASSWORD="false"
