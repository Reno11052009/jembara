DATABASE_URL=
DIRECT_URL=
# Opsional tetapi direkomendasikan: CA Supabase dalam format PEM yang di-base64
# untuk verifikasi sertifikat penuh. Tanpa nilai ini koneksi tetap diwajibkan TLS.
DATABASE_SSL_CA_BASE64=
SESSION_SECRET=

# Groq API key untuk pertanyaan umum chatbot. Rekomendasi project/talent
# dihitung secara lokal dari database dan tidak mengirim data database ke Groq.
CHATBOT_AI=
CHATBOT_AI_BACKUP=

# Midtrans Snap. Gunakan key Sandbox untuk pengembangan dan ubah environment
# menjadi production hanya setelah URL webhook HTTPS dikonfigurasi di MAP.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENVIRONMENT="sandbox"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage untuk lampiran pesan. Bucket harus private dan batas global
# serta bucket harus minimal 512 MB (memerlukan paket Supabase berbayar).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="message-attachments"

# Wajib saat menjalankan `npm run db:seed`; jangan gunakan nilai contoh/default.
ADMIN_SEED_NAME="Admin Jembara"
ADMIN_SEED_EMAIL="admin@jembara.web.id"
ADMIN_SEED_PASSWORD=

# Wajib saat menjalankan `npm run db:provision-runtime`.
DATABASE_RUNTIME_ROLE="jembara_runtime"
DATABASE_RUNTIME_PASSWORD=
# Set true hanya saat sengaja merotasi password role yang sudah ada.
DATABASE_RUNTIME_ROTATE_PASSWORD="false"
